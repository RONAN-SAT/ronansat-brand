{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ronansat-brand",
  "main": "worker.ts",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "routes": [
    {
      "pattern": "ronansat.com/favicon*",
      "zone_name": "ronansat.com",
    },
    {
      "pattern": "ronansat.com/icon.png*",
      "zone_name": "ronansat.com",
    },
    {
      "pattern": "ronansat.com/apple-icon.png*",
      "zone_name": "ronansat.com",
    },
    {
      "pattern": "ronansat.com/brand/favicon*",
      "zone_name": "ronansat.com",
    },
    {
      "pattern": "ronansat.com/brand/icon-white.png*",
      "zone_name": "ronansat.com",
    },
    {
      "pattern": "*.ronansat.com/favicon*",
      "zone_name": "ronansat.com",
    },
    {
      "pattern": "*.ronansat.com/icon.png*",
      "zone_name": "ronansat.com",
    },
    {
      "pattern": "*.ronansat.com/apple-icon.png*",
      "zone_name": "ronansat.com",
    },
    {
      "pattern": "*.ronansat.com/brand/favicon*",
      "zone_name": "ronansat.com",
    },
    {
      "pattern": "*.ronansat.com/brand/icon-white.png*",
      "zone_name": "ronansat.com",
    },
    {
      "pattern": "learn.ronansat.com/favicon*",
      "zone_name": "ronansat.com",
    },
    {
      "pattern": "learn.ronansat.com/icon.png*",
      "zone_name": "ronansat.com",
    },
    {
      "pattern": "learn.ronansat.com/apple-icon.png*",
      "zone_name": "ronansat.com",
    },
    {
      "pattern": "learn.ronansat.com/brand/favicon*",
      "zone_name": "ronansat.com",
    },
    {
      "pattern": "learn.ronansat.com/brand/icon-white.png*",
      "zone_name": "ronansat.com",
    },
    {
      "pattern": "forum.ronansat.com/favicon*",
      "zone_name": "ronansat.com",
    },
    {
      "pattern": "forum.ronansat.com/icon.png*",
      "zone_name": "ronansat.com",
    },
    {
      "pattern": "forum.ronansat.com/apple-icon.png*",
      "zone_name": "ronansat.com",
    },
    {
      "pattern": "forum.ronansat.com/brand/favicon*",
      "zone_name": "ronansat.com",
    },
    {
      "pattern": "forum.ronansat.com/brand/icon-white.png*",
      "zone_name": "ronansat.com",
    },
    {
      "pattern": "admin.ronansat.com/favicon*",
      "zone_name": "ronansat.com",
    },
    {
      "pattern": "admin.ronansat.com/icon.png*",
      "zone_name": "ronansat.com",
    },
    {
      "pattern": "admin.ronansat.com/apple-icon.png*",
      "zone_name": "ronansat.com",
    },
    {
      "pattern": "admin.ronansat.com/brand/favicon*",
      "zone_name": "ronansat.com",
    },
    {
      "pattern": "admin.ronansat.com/brand/icon-white.png*",
      "zone_name": "ronansat.com",
    },
    {
      "pattern": "pay.ronansat.com/favicon*",
      "zone_name": "ronansat.com",
    },
    {
      "pattern": "pay.ronansat.com/icon.png*",
      "zone_name": "ronansat.com",
    },
    {
      "pattern": "pay.ronansat.com/apple-icon.png*",
      "zone_name": "ronansat.com",
    },
    {
      "pattern": "pay.ronansat.com/brand/favicon*",
      "zone_name": "ronansat.com",
    },
    {
      "pattern": "pay.ronansat.com/brand/icon-white.png*",
      "zone_name": "ronansat.com",
    },
  ],
}
